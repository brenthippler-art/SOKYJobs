# Copy to .env.local for local testing. On Vercel, add these under
# Project > Settings > Environment Variables (never commit real values).

# Password for /admin. Use a long passphrase.
ADMIN_PASSWORD=

# Random string used to sign the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fine-grained GitHub token: this repo only, Contents: Read and write
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=brenthippler-art/soky-jobs
# Optional, defaults to main
GITHUB_BRANCH=main
